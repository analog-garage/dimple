
import sys
if sys.version_info >= (3, 8):
    from typing import Protocol
else:
    from typing_extensions import Protocol

import Jama
import java.util
import jpype
import org.apache.commons.math3.linear
import org.apache.commons.math3.random
import typing



class DimpleRandom(org.apache.commons.math3.random.RandomAdaptor):
    @typing.overload
    def __init__(self): ...
    @typing.overload
    def __init__(self, long: int): ...
    @typing.overload
    def __init__(self, randomGenerator: org.apache.commons.math3.random.RandomGenerator): ...
    @typing.overload
    def __init__(self, randomGenerator: org.apache.commons.math3.random.RandomGenerator, long: int): ...
    def getGenerator(self) -> org.apache.commons.math3.random.RandomGenerator: ...
    def getSeed(self) -> int: ...
    @typing.overload
    def nextBernoulli(self) -> int: ...
    @typing.overload
    def nextBernoulli(self, double: float) -> int: ...
    @typing.overload
    def nextBeta(self) -> float: ...
    @typing.overload
    def nextBeta(self, double: float, double2: float) -> float: ...
    def nextBinomial(self, int: int, double: float) -> int: ...
    @typing.overload
    def nextBoolean(self, double: float) -> bool: ...
    @typing.overload
    def nextBoolean(self) -> bool: ...
    @typing.overload
    def nextGamma(self) -> float: ...
    @typing.overload
    def nextGamma(self, double: float, double2: float) -> float: ...
    @typing.overload
    def setSeed(self, int: int) -> None: ...
    @typing.overload
    def setSeed(self, intArray: typing.Union[typing.List[int], jpype.JArray]) -> None: ...
    @typing.overload
    def setSeed(self, long: int) -> None: ...

class DimpleRandomGenerator:
    rand: typing.ClassVar[org.apache.commons.math3.random.RandomGenerator] = ...
    def __init__(self): ...
    @staticmethod
    def randomBinomial(int: int, double: float) -> int: ...
    @staticmethod
    def setSeed(long: int) -> None: ...

class Functions:
    def __init__(self): ...
    @staticmethod
    def logfactorial(int: int) -> float: ...
    @staticmethod
    def transpose(doubleArray: typing.Union[typing.List[typing.MutableSequence[float]], jpype.JArray]) -> typing.MutableSequence[typing.MutableSequence[float]]: ...

class LyricEigenvalueDecomposition(Jama.EigenvalueDecomposition):
    def __init__(self, matrix: Jama.Matrix): ...
    @staticmethod
    def checkMatrix(matrix: Jama.Matrix) -> Jama.Matrix: ...

class LyricSingularValueDecomposition(org.apache.commons.math3.linear.SingularValueDecomposition):
    def __init__(self, realMatrix: org.apache.commons.math3.linear.RealMatrix): ...

class MoreMatrixUtils:
    def __init__(self): ...
    @staticmethod
    def matrixGetDataRef(realMatrix: org.apache.commons.math3.linear.RealMatrix) -> typing.MutableSequence[typing.MutableSequence[float]]: ...
    @staticmethod
    def vectorGetDataRef(realVector: org.apache.commons.math3.linear.RealVector) -> typing.MutableSequence[float]: ...
    @staticmethod
    def wrapRealMatrix(doubleArray: typing.Union[typing.List[typing.MutableSequence[float]], jpype.JArray]) -> org.apache.commons.math3.linear.Array2DRowRealMatrix: ...
    @staticmethod
    def wrapRealVector(doubleArray: typing.Union[typing.List[float], jpype.JArray]) -> org.apache.commons.math3.linear.ArrayRealVector: ...

class RandomPlus(java.util.Random):
    def __init__(self): ...
    def nextDirichlet(self, doubleArray: typing.Union[typing.List[float], jpype.JArray]) -> typing.MutableSequence[float]: ...
    def nextGamma(self, double: float, double2: float) -> float: ...
    def nextPermutation(self, int: int) -> typing.MutableSequence[int]: ...

class Utilities:
    def __init__(self): ...
    @staticmethod
    def energyToWeight(double: float) -> float: ...
    @staticmethod
    def findMSB(int: int) -> int: ...
    @staticmethod
    def log2(double: float) -> float: ...
    @staticmethod
    def nextPow2(int: int) -> int: ...
    @staticmethod
    def normalize(doubleArray: typing.Union[typing.List[float], jpype.JArray]) -> typing.MutableSequence[float]: ...
    @staticmethod
    def sampleFromMultinomial(doubleArray: typing.Union[typing.List[float], jpype.JArray], random: java.util.Random) -> int: ...
    @staticmethod
    def weightToEnergy(double: float) -> float: ...


class __module_protocol__(Protocol):
    # A module protocol which reflects the result of ``jp.JPackage("com.analog.lyric.math")``.

    DimpleRandom: typing.Type[DimpleRandom]
    DimpleRandomGenerator: typing.Type[DimpleRandomGenerator]
    Functions: typing.Type[Functions]
    LyricEigenvalueDecomposition: typing.Type[LyricEigenvalueDecomposition]
    LyricSingularValueDecomposition: typing.Type[LyricSingularValueDecomposition]
    MoreMatrixUtils: typing.Type[MoreMatrixUtils]
    RandomPlus: typing.Type[RandomPlus]
    Utilities: typing.Type[Utilities]
